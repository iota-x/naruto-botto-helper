# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application id, and a guild id for registering slash commands
CLIENT_ID=
GUILD_ID=
# MongoDB connection string
MONGO_URI=
# Discord user id allowed to run the destructive `nh db …` commands
OWNER_ID=

# Optional debug capture — see README
# DEBUG_CAPTURE=all
# DEBUG_CAPTURE_FILE=./capture.jsonl
# DEBUG_TRACE=1
