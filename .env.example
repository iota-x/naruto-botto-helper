# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application id, and a guild id for registering slash commands
CLIENT_ID=
GUILD_ID=
# MongoDB connection string
MONGO_URI=
# Channels where the report helper may also name the option to click.
# Off everywhere by default — naming the button is answering for you.
# REPORT_ANSWER_CHANNELS=123456789,987654321

# The one game bot this helper reacts to. Defaults to Naruto Botto.
# GAME_BOT_ID=770100332998295572

# Discord user id allowed to run the destructive `nh db …` commands
OWNER_ID=

# Optional debug capture — see README
# DEBUG_CAPTURE=all
# DEBUG_CAPTURE_FILE=./capture.jsonl
# DEBUG_TRACE=1
